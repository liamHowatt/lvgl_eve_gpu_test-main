static uint32_t millis(void)
{
    int64_t micros = esp_timer_get_time();
    int64_t millis = micros / 1000;
    return millis;
}

/* Serial debugging */
void my_print(lv_log_level_t level, const char *buf)
{
    LV_UNUSED(level);
#if ARUDINO
    Serial.println(buf);
    Serial.flush();
#endif
}

static void tcb(lv_timer_t * tim)
{
    lv_obj_t * obj = lv_timer_get_user_data(tim);
    static lv_opa_t opa;
    lv_obj_set_style_bg_opa(obj, opa, 0);
    opa = ~opa;
    lv_obj_set_style_border_opa(obj, opa, 0);
}

